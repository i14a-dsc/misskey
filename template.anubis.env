# Anubis Configuration
# Uncomment and configure to enable Anubis bot protection
# Anubis sits in front of Misskey to protect against bots and scrapers
#
# Quick Instructions:
# 1. Copy this file: cp template.anubis.env anubis.env
# 2. Adjust settings below as needed
# 3. In compose.yml, uncomment the anubis service
# 4. Comment out or remove the "ports" section from the "web" service
#    (Anubis will handle external access on port 3000)
# 5. Start with: docker compose up -d

# Target service (Misskey web container)
TARGET=http://web:8080

BIND=:8923

USE_REMOTE_ADDRESS=true

# Difficulty of the proof-of-work challenge (higher = harder for bots, slower for users)
# Default: 5
DIFFICULTY=5

# Prometheus metrics port (optional, set to 0 to disable)
# METRICS_BIND=:9000

# Debug logging (set to "true" for verbose logs)
# DEBUG=false

# Policy file path
POLICY_FNAME: "/data/cfg/botPolicy.yaml"

# Serve Robots.txt with disallow all (default: false)
# SERVE_ROBOTS_TXT=true